# ============================================================
# FINORA — Variables de entorno
# ============================================================
# Copiá este archivo como `.env` y completá los valores.

# === Base de datos ===
# Producción: Neon / Supabase / Railway / Render
# Ejemplo Neon:
#   DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/finora?sslmode=require&schema=public"
#
# Dev local con Docker Postgres:
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=finora postgres:16-alpine
#   DATABASE_URL="postgresql://postgres:finora@localhost:5432/finora?schema=public"
DATABASE_URL="postgresql://postgres:finora@localhost:5432/finora?schema=public"

# === Auth ===
# Generá uno fuerte con:  openssl rand -base64 48
AUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_48_CHARS_MIN"

# URL pública de la app (sin trailing slash).
# Prod: https://finora.midominio.com
# Dev: http://localhost:3000
AUTH_URL="http://localhost:3000"

# === Entorno ===
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="FINORA"
NEXT_PUBLIC_BASE_CURRENCY="ARS"

# === Cotización manual fallback USD -> ARS ===
NEXT_PUBLIC_USD_ARS_FALLBACK="1450"

# === Bootstrap del primer usuario (opcional) ===
# Si lo activás, la próxima request a /api/bootstrap intentará crear
# el primer usuario leyendo FINORA_BOOTSTRAP_EMAIL y FINORA_BOOTSTRAP_PASSWORD
# desde el entorno del server (no expuestas al frontend).
# El endpoint se desactiva automáticamente una vez creado el usuario.
# Activar sólo en el primer deploy, luego desactivar.
FINORA_BOOTSTRAP_ENABLED="false"
FINORA_BOOTSTRAP_EMAIL=""
FINORA_BOOTSTRAP_PASSWORD=""

# === Seguridad adicional (opcional) ===
# TRUSTED_IPS_FOR_BOOTSTRAP="1.2.3.4" # sólo permitir bootstrap desde estas IPs
# MAX_LOGIN_ATTEMPTS_PER_HOUR="10"