# ============================================================
# FINORA — Variables de entorno (SELF-HOSTED)
# ============================================================
# Copiá este archivo como `.env` y completá los valores.
# ESTAS VARIABLES SON REQUERIDAS para que FINORA funcione.
# NO commitees el archivo `.env` real.

# === Base de datos (PostgreSQL LOCAL) ===
# Producción típica (Postgres en la misma PC):
#   DATABASE_URL="postgresql://finora_app:PASSWORD@127.0.0.1:5432/finora?schema=public"
# Producción Docker (Postgres en container adyacente):
#   DATABASE_URL="postgresql://finora_app:PASSWORD@postgres:5432/finora?schema=public"
# Producción LAN (Postgres en otra máquina de la LAN):
#   DATABASE_URL="postgresql://finora_app:PASSWORD@192.168.1.50:5432/finora?schema=public"
DATABASE_URL="postgresql://finora_app:CHANGE_ME@127.0.0.1:5432/finora?schema=public"

# === Auth (NextAuth) ===
# Generá uno fuerte con:  openssl rand -base64 48
# ESTE VALOR ES CRÍTICO. Si cambia, todas las sesiones se invalidan.
AUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_48_CHARS_MIN"

# URL pública de la app (sin trailing slash).
# Dev local:    http://localhost:3000
# Prod HTTPS:   https://finora.tudominio.com
AUTH_URL="http://localhost:3000"

# === Entorno ===
NODE_ENV="production"  # "development" sólo si estás haciendo dev local
TZ="America/Argentina/Buenos_Aires"  # default timezone explícito

# === Moneda base ===
NEXT_PUBLIC_BASE_CURRENCY="ARS"  # "USD" o la que prefieras
NEXT_PUBLIC_USD_ARS_FALLBACK="1450"  # cotización inicial fallback si no hay rate manual

# === Obsidian Vault (mirror human-readable + recovery source) ===
# Path absoluto al directorio raíz del Vault.
# En Windows:   C:\Users\TuUsuario\Documents\MiVault
# En Linux:     /home/finora/MiVault
# El sistema crea automáticamente la subcarpeta FINORA/ dentro de este path.
# No requiere que el Vault exista al iniciar (se crea si es necesario).
OBSIDIAN_VAULT_PATH=""

# === PostgreSQL backups (pg_dump) ===
# Directorio donde se guardan los dumps automáticos.
# Por defecto: ${OBSIDIAN_VAULT_PATH}/FINORA/98 Backups
# Recomendado: directorio DISTINTO del Vault (disco separado).
# Ejemplo Linux:  /var/backups/finora
# Ejemplo Windows: D:\Backups\FINORA
FINORA_BACKUP_PATH=""

# === pg_dump / pg_restore binaries ===
# Path absoluto si los binarios no están en $PATH del server.
# Linux típico:   /usr/bin/pg_dump
# Windows típico: C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
PG_DUMP_PATH="pg_dump"
PG_RESTORE_PATH="pg_restore"

# === Bootstrap del primer usuario (one-shot) ===
# IMPORTANTE: activar SOLO durante el primer deploy. Desactivar después.
# Si FINORA_BOOTSTRAP_ENABLED=true Y hay email/password válidos:
#   POST /api/bootstrap  →  crea el primer usuario
#   o:  npm run db:init-prod   (interactivo)
FINORA_BOOTSTRAP_ENABLED="false"
FINORA_BOOTSTRAP_EMAIL=""
FINORA_BOOTSTRAP_PASSWORD=""

# === Sync Worker (opcional, defaults razonables) ===
# Cada cuántos milisegundos el worker procesa eventos del outbox.
SYNC_INTERVAL_MS="5000"
# Tamaño del lote por iteración.
SYNC_BATCH_SIZE="50"

# === Postgres tuning (opcional) ===
# statement_timeout en milisegundos (0 = sin límite)
PG_STATEMENT_TIMEOUT_MS="0"

# === Notas ===
# - DATABASE_URL debe apuntar a Postgres 14+ (recomendado 16).
# - OBSIDIAN_VAULT_PATH puede omitirse si no querés sync al Vault (la app
#   funcionará pero la página /mas/sync y el worker mostrarán warnings).
# - TZ es importante: FINORA lo usa para agrupar gastos por mes.
# - AUTH_SECRET: nunca commitear, nunca loggear, nunca compartir.

# === Bootstrap example ===
# 1. Generar AUTH_SECRET:
#      openssl rand -base64 48
# 2. Activar bootstrap (TEMPORAL):
#      FINORA_BOOTSTRAP_ENABLED=true
#      FINORA_BOOTSTRAP_EMAIL=tu@email.com
#      FINORA_BOOTSTRAP_PASSWORD="TuPassFuerte!2024Min12"
# 3. Ejecutar el primer usuario (elegí uno):
#      a) HTTP:   curl -X POST http://localhost:3000/api/bootstrap
#      b) CLI:    npm run db:init-prod
# 4. DESACTIVAR bootstrap inmediatamente:
#      FINORA_BOOTSTRAP_ENABLED=false
# 5. Reiniciar la app.
# 6. Login con las credenciales en http://localhost:3000/login